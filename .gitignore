context/
__pycache__/
*.pyc
.venv/
.claude

# Evidencia subida a la API (fotos/videos de bitácoras): datos, no código
API/uploads/

# Firmware ESP-IDF: red de seguridad por si un ejemplo no trae su .gitignore
# (sdkconfig guarda contraseñas de WiFi y de la máquina)
enbedded/**/build/
enbedded/**/managed_components/
enbedded/**/sdkconfig
enbedded/**/sdkconfig.old

# Clave que firma los JWT de la API (se genera sola si falta)
API/secret_key.txt

# Clave para subir y desplegar firmware OTA desde esta PC sin usuario (enbedded/tools/ota_subir.py)
API/ota_deploy_key.txt
