# Valores base del ejemplo. "sdkconfig" se genera a partir de este archivo
# (y está en .gitignore); si cambias algo aquí, borra sdkconfig y recompila.
# Las credenciales van en sdkconfig.defaults.local (ver sdkconfig.defaults.local.ejemplo).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Placa ESP32-S3R8: 8 MB de PSRAM octal. Los buffers de WiFi/lwIP y mbedTLS
# van a PSRAM para dejar la RAM interna a las tareas de los sensores.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# La placa se conecta por el puerto UART (chip CH343, COM9): consola en UART0
# (GPIO43/44). El GPS usa el UART1 (GPIO17/18), así que no hay choque.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Tick de FreeRTOS de 1 ms (por defecto 10 ms): las conversiones del
# barómetro duran 0.6-9 ms, la calibración del giroscopio usa vTaskDelay(1)
# y el GPS cierra cada medida tras 30 ms de silencio en el UART.
CONFIG_FREERTOS_HZ=1000

# TLS (wss/https hacia api.superbaay.dev): el certificado de Cloudflare se
# valida con el bundle de CAs de ESP-IDF.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# El handshake de mbedTLS necesita más pila que los 3.5 KB por defecto.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Flash real de la N16R8: 16 MB. Tabla propia con dos ranuras OTA de 4 MB
# (partitions.csv): la app ocupa ~1.1 MB con WiFi + TLS + bundle de certificados.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Rollback: una versión que llega por OTA arranca "pendiente de verificar" y,
# si no se confirma (ota_dron.c, al conectarse a la API), el bootloader vuelve
# a la anterior. Cambia el bootloader: el primer flasheo tras esto va por USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
