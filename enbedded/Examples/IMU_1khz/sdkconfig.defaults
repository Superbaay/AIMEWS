# Valores base del ejemplo. "sdkconfig" se genera a partir de este archivo
# (y está en .gitignore); si cambias algo aquí, borra sdkconfig y recompila.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Consola y logs por el USB nativo (COM8, el mismo puerto de flasheo).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Tick de FreeRTOS de 1 ms (por defecto 10 ms). No es necesario para leer
# por interrupción, pero sí para que vTaskDelay(1) dure 1 ms (lo usa la
# calibración del giroscopio).
CONFIG_FREERTOS_HZ=1000
