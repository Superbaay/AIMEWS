# Valores base del ejemplo. "sdkconfig" se genera a partir de este archivo
# (y está en .gitignore); si cambias algo aquí, borra sdkconfig y recompila.
# Las credenciales van en sdkconfig.defaults.local (ver sdkconfig.defaults.local.ejemplo).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Placa ESP32-S3-WROOM CAM N16R8: 16 MB de flash QIO + 8 MB de PSRAM OCTAL.
# Los frames de la cámara, los buffers de WiFi/lwIP y mbedTLS van a la PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Caché de datos grande: el driver de la cámara copia cada bloque DMA a la PSRAM.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Consola en el puerto UART de la placa (CH343, COM5).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000

# Cámara: solo el OV3660 de la placa. La tarea del driver va en el núcleo 1; el
# núcleo 0 queda para WiFi, TLS y los WebSockets.
# NO activar CONFIG_CAMERA_PSRAM_DMA: medido, corrompe 23-119 de cada 120 frames.
CONFIG_OV3660_SUPPORT=y
CONFIG_OV2640_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV3640_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
CONFIG_CAMERA_CORE1=y

# TLS (wss/https hacia api.superbaay.dev): el certificado de Cloudflare se
# valida con el bundle de CAs de ESP-IDF.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Tabla propia con dos ranuras OTA de 4 MB (partitions.csv, la misma del dron).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Rollback: una versión que llega por OTA arranca "pendiente de verificar" y, si
# no se confirma (ota_camara.c, al conectarse a la API), el bootloader vuelve a la
# anterior. Cambia el bootloader: el PRIMER flasheo de este ejemplo va por USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Búferes TCP medidos en la placa (WiFi de casa + Cloudflare, ~150-300 kbit/s):
# - Envío 23040 (16 segmentos). Con 65534 se encolaban 2-4 s de vídeo: el token del
#   canal de control llegaba tarde (la API cierra con "Unauthorized" a los 5 s), los
#   pings caducaban y el vídeo iba con segundos de retraso. Con 11520 la cola era
#   corta pero el caudal caía a la mitad (~20 KB/s: RTT efectivo de hasta 0,5 s).
# - Recepción (CONFIG_LWIP_TCP_WND_DEFAULT) por defecto (5760, como el dron): con 65534
#   y los buffers de RX por defecto, la descarga de la OTA se quedó en 0 %.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
